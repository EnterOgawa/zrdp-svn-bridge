#include <windows.h>
#include <winver.h>
#include "agent_tray_resources.h"

STRINGTABLE
BEGIN
    IDS_AGENT_TRAY_WAITING "ZRdp SVN Bridge - Agent: Client接続待ち"
    IDS_AGENT_TRAY_READY "ZRdp SVN Bridge - Agent: SVN Bridge接続済み"
    IDS_AGENT_TRAY_RECOVERING "ZRdp SVN Bridge - Agent: RDP復帰待ち"
    IDS_AGENT_TRAY_UNAVAILABLE "ZRdp SVN Bridge - Agent: SVN Bridge利用不能"
    IDS_AGENT_TRAY_EXIT "Agentを終了"
    IDS_AGENT_TRAY_FAILED "Agentのタスクトレイ表示を維持できないため停止しました。接続先のExplorerと通知領域を確認してから、再度起動してください。"
    IDS_AGENT_SETUP_RUNNING "このRDPセッションでAgentが起動中、または配置処理が実行中です。Agentのタスクトレイから終了してください。旧console版はCtrl+Cで終了し、新しいRDP接続からAgent起動をやり直してください。強制終了や上書きは行っていません。"
    IDS_AGENT_SESSION_REQUIRED "AgentはactiveなRDPユーザーセッション内で起動してください。"
    IDS_AGENT_ALREADY_RUNNING "このRDPセッションではAgentが起動済みです。既存Agentのタスクトレイで状態を確認してください。"
    IDS_AGENT_CHANNEL_UNAVAILABLE "ESVNBRGを開けません。ZRdp Clientから接続した同じRDPセッションで起動してください。"
    IDS_AGENT_BRIDGE_STOPPED "protocolまたはSVN stream処理のエラーでAgentを停止しました。診断ログとClientの状態を確認してください。RDP接続自体は維持します。"
    IDS_AGENT_SETUP_ROLLBACK_FAILED "Agent更新に失敗し、元の二ファイルへ自動復旧できませんでした。Agentは起動していません。接続先の %LOCALAPPDATA%\\ZRdp\\backup-* に元ファイルを保全しています。バックアップを確認し、旧Agentとagent.iniを復旧してください。"
END

// -----------------------------------------------------------------------------
// Portable EXE version情報
// -----------------------------------------------------------------------------

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,7,21,0
PRODUCTVERSION 0,7,21,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104B0"
        BEGIN
            VALUE "CompanyName", "EnterOgawa\0"
            VALUE "FileDescription", "ZRdp SVN Agent\0"
            VALUE "FileVersion", "0.7.21.0\0"
            VALUE "InternalName", "ZRdpSvnAgent\0"
            VALUE "OriginalFilename", "ZRdpSvnAgent.exe\0"
            VALUE "ProductName", "ZRdp SVN Bridge\0"
            VALUE "ProductVersion", "0.7.21.0\0"
            VALUE "AgentSetupProtocol", "1\0"
            VALUE "BridgeProtocol", "1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0411, 1200
    END
END
