#pragma code_page(65001)

/**
 * @file ZRdpSvnBridge.rc
 * @brief Clientのmanifest、version、icon、日本語UI文字列を定義する。
 *
 * @details credentialや実接続先をresourceへ埋め込まず、配布EXEに必要な
 *          固定metadataと利用者向け文字列だけを保持する。
 */

#include "resource.h"
#include <windows.h>
#include <winver.h>

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

// -----------------------------------------------------------------------------
// 実行時manifest
// -----------------------------------------------------------------------------

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

IDR_MAIN_MANIFEST RT_MANIFEST "ZRdpSvnBridge.manifest"

// -----------------------------------------------------------------------------
// Portable EXE version情報
// -----------------------------------------------------------------------------

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,7,14,0
PRODUCTVERSION 0,7,14,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104B0"
        BEGIN
            VALUE "CompanyName", "EnterOgawa\0"
            VALUE "FileDescription", "ZRdp SVN Bridge\0"
            VALUE "FileVersion", "0.7.14.0\0"
            VALUE "InternalName", "ZRdpSvnBridge\0"
            VALUE "OriginalFilename", "ZRdpSvnBridge.exe\0"
            VALUE "ProductName", "ZRdp SVN Bridge\0"
            VALUE "ProductVersion", "0.7.14.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0411, 1200
    END
END

STRINGTABLE
BEGIN
    IDS_APP_TITLE                     "ZRdp SVN Bridge - Phase 9 (0.7.14)"
    IDS_CONNECTION_NAME_LABEL         "接続名:"
    IDS_SERVER_LABEL                  "接続先:"
    IDS_DOMAIN_LABEL                  "ドメイン:"
    IDS_USER_NAME_LABEL               "ユーザー名:"
    IDS_CONNECT                       "接続"
    IDS_DISCONNECT                    "切断"
    IDS_FULL_SCREEN                   "全画面"
    IDS_WINDOW_MODE                   "ウィンドウ"
    IDS_DISPLAY_MODE_NATIVE           "等倍表示（スクロール）"
    IDS_STATUS_DISCONNECTED           "RDP: 未接続 | SVN Bridge: 停止"
    IDS_STATUS_CONNECTING             "RDP: 接続中 | SVN Bridge: 停止"
    IDS_STATUS_CONNECTED              "RDP: 接続済み | SVN Bridge: Agent確認中（Echo成立前はSVNを利用できません）"
    IDS_STATUS_DISCONNECTING          "RDP: 切断中 | SVN Bridge: 停止"
    IDS_STATUS_RECONNECTING           "RDP: 自動再接続中 | SVN Bridge: 停止"
    IDS_STATUS_AUTH_WARNING           "RDP: 認証警告を表示中（自動承認しません） | SVN Bridge: 停止"
    IDS_STATUS_WARNING_FORMAT         "RDP警告: code=%ld | SVN Bridge: 専用状態欄を確認してください"
    IDS_STATUS_FATAL_FORMAT           "RDP致命的エラー: code=%ld | SVN Bridge: 停止"
    IDS_STATUS_DISCONNECTED_FORMAT    "RDP: 切断（reason=%ld, extended=%ld） | SVN Bridge: 停止"
    IDS_SERVER_REQUIRED               "接続先PC名またはIPアドレスを入力してください。"
    IDS_ACTIVE_X_CREATE_FAILED        "Windows Remote Desktop ActiveX Controlを作成できませんでした。"
    IDS_CONNECT_FAILED                "RDP接続を開始できませんでした。"
    IDS_DISCONNECT_FAILED             "RDP切断要求を送信できませんでした。"
    IDS_CLOSE_CONFIRM                 "RDP接続中です。切断してZRdp SVN Bridgeを終了しますか？"
